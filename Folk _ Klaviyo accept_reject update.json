        "jsCode": "const results = [];\n\nfor (const item of items) {\n  // Parse stringified Klaviyo response\n  let parsed;\n  try {\n    parsed = JSON.parse(item.json.data);\n  } catch (e) {\n    continue; // skip invalid JSON\n  }\n\n  // If profile exists, push it\n  if (parsed?.data && parsed.data.length > 0) {\n    for (const profile of parsed.data) {\n      results.push({\n        json: profile\n      });\n    }\n  }\n}\n\nreturn results;\n"
