    {
      "parameters": {
        "jsCode": "// Get AI text output\nconst aiText = items[0].json.output;\n\n// Helper function to extract block by heading\nfunction extractBlock(text, heading) {\n  const regex = new RegExp(`### 📌 ${heading}[\\\\s\\\\S]*?(?=### 📌|$)`, \"g\");\n  const match = text.match(regex);\n  if (!match) return \"\";\n  return match[0]\n    .replace(`### 📌 ${heading}`, \"\")\n    .trim();\n}\n\n// Extract sections\nconst timestamps = extractBlock(aiText, \"TIMESTAMPS\");\nconst instagram = extractBlock(aiText, \"INSTAGRAM CAPTION\");\nconst linkedin = extractBlock(aiText, \"LINKEDIN POST\");\nconst xBlock = extractBlock(aiText, \"X POSTS\");\n\n// Extract X/twitter posts into array\nlet x_posts = [];\nif (xBlock) {\n  x_posts = xBlock\n    .split(/\\n\\d+\\.\\s+/)        // split by 1. 2. 3.\n    .map(t => t.trim())\n    .filter(t => t.length > 0);\n}\n\n// Return parsed JSON\nreturn [\n  {\n    json: {\n      timestamps,\n      instagram,\n      linkedin,\n      x_posts\n    }\n  }\n];\n"
      },
