    {
      "parameters": {
        "jsCode": "const item = $json.data?.items?.[0];\nif (!item) {\n  return [{ json: { exploreFolderId: null, error: \"No items found\" }}];\n}\n\nconst groups = item.customFieldValues || {};\nconst groupKeys = Object.keys(groups);\n\nlet link = null;\n\n// Find the first non-null link\nfor (const key of groupKeys) {\n  const group = groups[key];\n  for (const fieldName in group) {\n    if (group[fieldName] && typeof group[fieldName] === \"string\") {\n      link = group[fieldName];\n      break;\n    }\n  }\n  if (link) break;\n}\n\n// If no valid link found\nif (!link || !link.includes(\"/folders/\")) {\n  return [{\n    json: {\n      exploreFolderId: null,\n      rawLink: link,\n      error: \"No valid drive link found\"\n    }\n  }];\n}\n\n// Extract folder ID\nconst folderId = link.split(\"/folders/\")[1]?.split(\"?\")[0] || null;\n\nreturn [{\n  json: {\n    exploreFolderId: folderId,\n    rawLink: link\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        992,
        912
      ],
