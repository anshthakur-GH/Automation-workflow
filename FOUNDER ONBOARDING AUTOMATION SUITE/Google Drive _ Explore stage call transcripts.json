    {
      "parameters": {
        "jsCode": "// Input: output of \"Get a document\" node (Google Docs full JSON)\nconst doc = $json || {}; // safe fallback\n\n// Get docId and title\nconst docId = doc.documentId || doc.documentId || (doc.documentId && String(doc.documentId)) || null;\nconst title = (doc.title || doc.name || \"\").toString();\n\n// Helper: recursively walk content blocks and collect person emails\nconst emailsSet = new Set();\nconst dqIgnore = \"@dqventures.com\";\n\nfunction walkContent(content) {\n  if (!Array.isArray(content)) return;\n  for (const block of content) {\n    // paragraph elements\n    if (block.paragraph?.elements && Array.isArray(block.paragraph.elements)) {\n      for (const el of block.paragraph.elements) {\n        // prefer explicit personProperties.email\n        const p = el.person?.personProperties;\n        if (p?.email) {\n          const e = String(p.email).trim().toLowerCase();\n          if (e && !e.endsWith(dqIgnore)) emailsSet.add(e);\n        }\n        // sometimes email stored in name field\n        if (p?.name && typeof p.name === \"string\") {\n          const n = p.name.trim().toLowerCase();\n          if (n.includes(\"@\") && !n.endsWith(dqIgnore)) emailsSet.add(n);\n        }\n      }\n    }\n\n    // tables -> cells -> content\n    if (block.table?.tableRows && Array.isArray(block.table.tableRows)) {\n      for (const row of block.table.tableRows) {\n        for (const cell of row.tableCells || []) {\n          walkContent(cell.content);\n        }\n      }\n    }\n\n    // nested content blocks (rare)\n    if (block.content && Array.isArray(block.content)) {\n      walkContent(block.content);\n    }\n  }\n}\n\n// run walker on top-level doc body\nwalkContent(doc.body?.content || []);\n\n// build unique array\nconst emails = Array.from(emailsSet);\n\n// Return single item that contains:\n// - emails: array of strings\n// - docId: string (Google doc id)\n// - title: string (document title)\nreturn [\n  {\n    json: {\n      emails,\n      docId,\n      title\n    }\n  }\n];\n"
      },
