      "parameters": {
        "jsCode": "// Get all spaces from the API response\nconst allSpaces = $input.first().json.spaces || [];\n\n// Get the email from Folk\nconst folkEmail = $('Get Person Details from folk').first().json.data.emails[0];\n\nconsole.log('Looking for email:', folkEmail);\nconsole.log('Total spaces:', allSpaces.length);\n\n// Filter to find matching spaces\nconst matchingSpaces = allSpaces.filter(space => \n  space.contactEmail === folkEmail\n);\n\nconsole.log('Matching spaces:', matchingSpaces.length);\n\n// Return in the same format as before\nreturn [{\n  json: {\n    spaces: matchingSpaces\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
