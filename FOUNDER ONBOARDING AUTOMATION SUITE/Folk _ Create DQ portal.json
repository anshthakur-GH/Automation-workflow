      "parameters": {
        "jsCode": "// Retrieve Google Doc URL from Folk webhook data\nconst webhookData = $('Get Person Details from folk').first().json.data;\nconsole.log('webhook data:', webhookData);\n\n// ✅ Safely get the investment memo URL with null checks\nconst customFields = webhookData?.customFieldValues?.['grp_323c561b-8741-4c14-9a6b-e72bc1dbeb9f'];\nconst memoUrl = customFields?.['Investment Memo 1'] || null;\n\nconsole.log('memo URL:', memoUrl);\n\n// ✅ Only process if memoUrl exists and is not empty\nlet embedUrl = '';\nif (memoUrl && memoUrl.trim() !== '') {\n  embedUrl = memoUrl;\n  \n  // Convert Google Doc URL to embeddable/preview format\n  if (memoUrl.includes('docs.google.com/document')) {\n    embedUrl = memoUrl.replace(/\\/edit.*$/, '/preview');\n  }\n} else {\n  console.log('No memo URL found - will skip embedding');\n}\n\n// Get the space data from previous node\nconst spaceData = $('Create ValueCase Space1').first().json;\n\n// Return data with proper null handling\nreturn [{\n  json: {\n    embedUrl: embedUrl || '',\n    originalMemoUrl: memoUrl || '',\n    hasMemoUrl: !!memoUrl,  // ✅ Boolean flag to indicate if memo exists\n    spaceId: spaceData.id || spaceData.spaceId,\n    spaceSlug: spaceData.slug || spaceData.spaceSlug,\n    spaceUrl: spaceData.url || ''\n  }\n}];"
      },
