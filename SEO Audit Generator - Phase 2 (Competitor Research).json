{
  "name": "SEO Audit Generator - Phase 2 (Competitor Research)",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of items) {\n  const competitorEngineId = item.json.site_engine_id;\n  const keywords = item.json.keywords || [];\n\n  for (const kw of keywords) {\n    const posObj = kw.positions?.[0] || {};\n\n    output.push({\n      json: {\n        keyword: kw.name,\n        volume: Number(kw.volume || 0),\n        competitor_position: posObj.pos ?? null,\n        competitor_url: posObj.url ?? null,\n        competitor_engine_id: competitorEngineId\n      }\n    });\n  }\n}\n\nreturn output;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        -144
      ],
      "id": "d1c57ae3-4e51-4537-9bbe-ce365ae1dd55",
      "name": "Flatten all keywords"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://searchconsole.googleapis.com/webmasters/v3/sites/sc-domain:dataclicks.nl/searchAnalytics/query\n",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"startDate\": \"2025-10-15\",\n  \"endDate\": \"2025-11-15\",\n  \"dimensions\": [\"query\"],\n  \"rowLimit\": 5000,\n  \"searchType\": \"web\"\n}\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -240,
        272
      ],
      "id": "f1fead26-2dd8-47c0-a3c5-a755036a13be",
      "name": "Search Console"
    },
    {
      "parameters": {
        "jsCode": "return $json.rows.map(r => ({\n  json: {\n    keyword: r.keys[0],\n    clicks: r.clicks,\n    impressions: r.impressions,\n    ctr: r.ctr,\n    position: r.position\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -48,
        272
      ],
      "id": "1d2e20f2-68a1-4b0c-a582-10aa321f1c60",
      "name": "Clean + Flatten GSC Output"
    },
    {
      "parameters": {
        "compare": "selectedFields",
        "fieldsToCompare": "keyword",
        "options": {}
      },
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        160,
        272
      ],
      "id": "afab9e3f-9366-4ec4-861f-ab6f51ab1532",
      "name": "Remove Duplicate Keyword From GSC"
    },
    {
      "parameters": {
        "compare": "selectedFields",
        "fieldsToCompare": "keyword",
        "options": {}
      },
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        128,
        64
      ],
      "id": "7e3b2ea0-c609-4773-8abc-6803c5aa8fe3",
      "name": "Remove Duplicate Keyword SE Ranking"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  let kw = item.json.keyword || item.json.name || item.json.keys?.[0] || \"\";\n\n  kw = kw\n    .toString()\n    .toLowerCase()\n    .trim()\n    .replace(/[^a-z0-9\\s]/g, \"\")  // remove hyphens, commas, symbols\n    .replace(/\\s+/g, \" \");        // collapse double spaces\n\n  item.json.keyword = kw;\n\n  return item;\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        272
      ],
      "id": "37cd209d-931b-4dfb-aa49-7187c2d69aca",
      "name": "Keyword normalization GSC"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  let kw = item.json.keyword || item.json.name || item.json.keys?.[0] || \"\";\n\n  kw = kw\n    .toString()\n    .toLowerCase()\n    .trim()\n    .replace(/[^a-z0-9\\s]/g, \"\")  // remove hyphens, commas, symbols\n    .replace(/\\s+/g, \" \");        // collapse double spaces\n\n  item.json.keyword = kw;\n\n  return item;\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        64
      ],
      "id": "d80c0183-60e8-423b-b570-e5db03007eaf",
      "name": "Keyword normalization SE Ranking"
    },
    {
      "parameters": {
        "jsCode": "return items.map(i => {\n  const j = i.json;\n\n  j.bucket =\n    j.competitor_position !== undefined && j.position === undefined\n      ? \"competitor-only\"\n      : j.competitor_position === undefined && j.position !== undefined\n      ? \"gsc-only\"\n      : \"both\";\n\n  return { json: j };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        160
      ],
      "id": "112bd805-fd46-408a-81ca-cb7a84c724ae",
      "name": "Categorizer based on Keyword"
    },
    {
      "parameters": {
        "mode": "combine",
        "fieldsToMatchString": "keyword",
        "joinMode": "keepEverything",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        544,
        160
      ],
      "id": "5e361cee-3baf-4fba-a493-e7c529861a92",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "return items\n  .map(i => {\n    const d = { ...i.json };\n    let score = 0;\n    // Bucket weight\n    if (d.bucket === \"competitor-only\") score += 50;\n    else if (d.bucket === \"both\") score += 30;\n    else if (d.bucket === \"gsc-only\") score += 20;\n    // Volume weight\n    const volume = Number(d.volume || 0);\n    score += Math.min(volume, 50);\n    // Position weight (GSC position)\n    const position = Number(d.position || 0);\n    if (position > 0) {\n      score += (100 - position) / 2;\n    }\n    d.priority_score = Math.round(score);\n    return { json: d };\n  })\n  .sort((a, b) => b.json.priority_score - a.json.priority_score);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        160
      ],
      "id": "9977520d-5b8b-4b51-8925-8200f3a5586a",
      "name": "Priority Scoring & Ordering"
    },
