    {
      "parameters": {
        "jsCode": "const brand = $node[\"On form submission\"].json[\"Enter Domain for Analysis\"]\n  .replace(\"https://\", \"\")\n  .replace(\"http://\", \"\")\n  .replace(\"www.\", \"\")\n  .split(\".\")[0]\n  .toLowerCase();\n\nreturn items.filter(i => {\n  const kw = (i.json.keyword || \"\").toLowerCase();\n  return !kw.includes(brand);\n});\n"
      },
