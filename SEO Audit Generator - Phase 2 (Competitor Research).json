      "name": "Get All Projects"
    },
    {
      "parameters": {
        "jsCode": "const formDomain = $node[\"On form submission\"].json[\"Enter Domain for Analysis\"];\n\nconst inputDomain = formDomain\n  .replace(\"https://\", \"\")\n  .replace(\"http://\", \"\")\n  .replace(\"www.\", \"\")\n  .replace(\"/\", \"\")\n  .toLowerCase();\n\nfor (const item of items) {\n  const siteName = item.json.name || \"\";\n\n  const siteDomain = siteName\n    .replace(\"https://\", \"\")\n    .replace(\"http://\", \"\")\n    .replace(\"www.\", \"\")\n    .replace(\"/\", \"\")\n    .toLowerCase();\n\n  if (siteDomain.includes(inputDomain)) {\n    return [{ json: { site_id: item.json.id } }];\n  }\n}\n\nthrow new Error(\"No matching SE Ranking site found\");\n"
      },
