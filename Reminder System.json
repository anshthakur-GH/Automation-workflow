    {
      "parameters": {
        "jsCode": "// ---- helpers ----\nfunction parseDDMMYYYY(s) {\n  if (!s) return null;\n  const [dd, mm, yyyy] = s.split(\"-\").map(n => parseInt(n, 10));\n  const d = new Date(yyyy, (mm - 1), dd);\n  d.setHours(0, 0, 0, 0);\n  return d;\n}\n\nfunction formatDDMMYYYY(d) {\n  const dd = String(d.getDate()).padStart(2, \"0\");\n  const mm = String(d.getMonth() + 1).padStart(2, \"0\");\n  const yyyy = d.getFullYear();\n  return `${dd}-${mm}-${yyyy}`;\n}\n\n// Add 1 calendar month, clamp to last day if needed\nfunction addOneMonthFrom(date) {\n  const day = date.getDate();\n  const month = date.getMonth();\n  const year = date.getFullYear();\n  const lastDayNextMonth = new Date(year, month + 2, 0).getDate();\n  const newDay = Math.min(day, lastDayNextMonth);\n  const next = new Date(year, month + 1, newDay);\n  next.setHours(0, 0, 0, 0);\n  return next;\n}\n\n// ---- main ----\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nconst out = [];\n\nfor (const item of items) {\n  const row = item.json;\n\n  const status = (row[\"Payment Status\"] || \"\").toLowerCase().trim(); // 'paid' | 'unpaid'\n  const dueStr = row[\"Due Date\"];\n  const baseFee = parseFloat(row[\"Base Fees\"]) || 0;\n\n  const due = parseDDMMYYYY(dueStr);\n  if (!due) continue;\n\n  // Case 1: PAID -> roll to next cycle and reset\n  if (status === \"paid\") {\n    const nextDue = addOneMonthFrom(due);\n    out.push({\n      json: {\n        row_number: row.row_number ?? row[\"row_number\"],\n        \"Due Date\": formatDDMMYYYY(nextDue),\n        \"Payment Status\": \"unpaid\", // start new cycle\n        \"Amount Due\": baseFee,\n        \"Months Overdue\": 0,\n      }\n    });\n    continue;\n  }\n\n  // Case 2: UNPAID & overdue -> accumulate\n  if (status === \"unpaid\" && due < today) {\n    // months difference by calendar months\n    const diffMonths = Math.floor(\n      (today.getFullYear() - due.getFullYear()) * 12 +\n      (today.getMonth() - due.getMonth())\n    );\n\n    // Option A (default): count owed cycles (today overdue -> 1)\n    const monthsOverdue = diffMonths + 1;\n\n    // Option B: if you want 0 until a full month passes, use:\n    // const monthsOverdue = diffMonths;\n\n    const newAmountDue = baseFee * monthsOverdue;\n\n    out.push({\n      json: {\n        row_number: row.row_number ?? row[\"row_number\"],\n        \"Due Date\": formatDDMMYYYY(due), // keep the same to avoid blanks\n        \"Payment Status\": \"unpaid\",\n        \"Amount Due\": newAmountDue,\n        \"Months Overdue\": monthsOverdue,\n      }\n    });\n    continue;\n  }\n\n  // Case 3: UNPAID but not overdue yet -> no change (emit nothing)\n}\n\nreturn out;\n"
      },
