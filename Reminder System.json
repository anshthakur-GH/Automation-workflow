      "id": "97d0e121-0228-47bf-a8ca-d14d50d7bb9b",
      "name": "Firm Reminder"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const name = item.json[\"Name\"];\n  const amountDue = item.json[\"Amount Due\"];\n  const course = item.json[\"Course\"];\n  const dueDate = item.json[\"Due Date\"];\n  const institute = item.json[\"Institute Name\"];\n  const institutePhone = item.json[\"Institute Phone\"] || \"\";\n  const instituteEmail = item.json[\"Institute Email\"] || \"\";\n\n  // Format phone numbers\n  let phoneFormatted = \"\";\n  if (institutePhone) {\n    const phones = institutePhone.split(\",\").map(p => p.trim());\n    phoneFormatted = phones.map(p => `📞 ${p}`).join(\"\\n\");\n  }\n\n  let contactInfo = \"\";\n  if (phoneFormatted) contactInfo += phoneFormatted + \"\\n\";\n  if (instituteEmail) contactInfo += `✉️ ${instituteEmail}`;\n\n  const message = `🚨 URGENT NOTICE  \n\n${name}, your fee of ₹${amountDue} for *${course}* was due on ${dueDate} and remains unpaid.  \n\nImmediate payment is required to avoid penalties and ensure uninterrupted access to classes.  \n\nFailure to pay promptly may result in suspension of services.  \n\n- ${institute}  \n${contactInfo}`;\n\n  return {\n    json: {\n      ...item.json,\n      message,\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
