    {
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\nconst toNum = v => isNaN(parseFloat(v)) ? 0 : parseFloat(v);\n\nconst normalized = rows.map(r => ({\n  name: r['Name'] || '',\n  email: r['Email'] || '',\n  phone: r['Phone'] || '',\n  whatsapp: r['WhatsApp'] || '',\n  course: r['Course'] || '',\n  institute: r['Institute Name'] || '',\n  due_date: r['Due Date'] || '',\n  base_fees: toNum(r['Base Fees'] || 0),\n  amount_due: toNum(r['Amount Due'] || 0),\n  months_overdue: toNum(r['Months Overdue'] || 0),\n  payment_status: r['Payment Status'] || '',\n  last_reminded_date: r['Last Reminded Date'] || '',\n  is_defaulter: r['Payment Status'].toLowerCase() === 'unpaid'\n}));\n\nlet totalBaseFees = 0, totalDue = 0, totalSaved = 0, totalDefaulters = 0;\nnormalized.forEach(r => {\n  totalBaseFees += r.base_fees;\n  totalDue += r.amount_due;\n  totalSaved += r.base_fees - r.amount_due;\n  if (r.is_defaulter) totalDefaulters += 1;\n});\n\nreturn {\n  json: {\n    records: normalized,\n    dashboard: {\n      totalBaseFees,\n      totalDue,\n      totalSaved,\n      totalDefaulters\n    }\n  }\n};\n"
      },
