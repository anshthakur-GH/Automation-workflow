      ],
      "id": "3528ee9c-04f7-4519-9b17-bb709d2adb1b",
      "name": "Urgent Reminder"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const name = item.json[\"Name\"];\n  const amountDue = item.json[\"Amount Due\"];\n  const course = item.json[\"Course\"];\n  const dueDate = item.json[\"Due Date\"];\n  const institute = item.json[\"Institute Name\"];\n\n  // Use the exact key with trailing space\n  const institutePhone = item.json[\"Institute Phone\"] || \"\";\n  const instituteEmail = item.json[\"Institute Email\"] || \"\";\n  \n\n  // Format multiple phone numbers (comma separated)\n  let phoneFormatted = \"\";\n  if (institutePhone) {\n    const phones = institutePhone.split(\",\").map(p => p.trim());\n    phoneFormatted = phones.map(p => `📞 ${p}`).join(\"\\n\");\n  }\n\n  // Collect contact info\n  let contactInfo = \"\";\n  if (phoneFormatted) contactInfo += phoneFormatted + \"\\n\";\n  if (instituteEmail) contactInfo += `✉️ ${instituteEmail}`;\n\n  const message = `Hello ${name},\n\nThis is a friendly reminder that your fee of ₹${amountDue} for *${course}* is due on ${dueDate}.\n\nPlease make the payment at the earliest.\n\nRegards,  \n${institute}  \n${contactInfo}`;\n\n  return {\n    json: {\n      ...item.json,\n      message,\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        528
      ],
      "id": "62415e60-bf50-4337-b7e0-2c835149ecee",
      "name": "Gentle Reminder"
    },
    {
      "parameters": {
        "jsCode": "const today = new Date();\ntoday.setHours(0, 0, 0, 0); // reset time for accurate comparison\n\nreturn items.map(item => {\n  let reminderStage = \"\";\n\n  // --- Parse Due Date ---\n  let dueDateStr = (item.json[\"Due Date\"] || \"\").trim();\n  let dueDate;\n\n  // Handle dd-mm-yyyy or dd/mm/yyyy\n  if (/^\\d{2}[-/]\\d{2}[-/]\\d{4}$/.test(dueDateStr)) {\n    const parts = dueDateStr.split(/[-/]/);\n    const day = Number(parts[0]);\n    const month = Number(parts[1]) - 1;\n    const year = Number(parts[2]);\n    dueDate = new Date(year, month, day);\n  } else {\n    // fallback: try default Date parser (handles ISO from Google Sheets)\n    dueDate = new Date(dueDateStr);\n  }\n\n  dueDate.setHours(0, 0, 0, 0);\n\n  // --- Calculate days difference ---\n  const diffMs = dueDate.getTime() - today.getTime();\n  const daysDiff = Math.round(diffMs / (1000 * 60 * 60 * 24));\n\n  // --- Reminder stage logic ---\n  const status = (item.json[\"Payment Status\"] || \"\").trim().toLowerCase();\n\n  if (status === \"unpaid\") {\n    if (daysDiff > 0 && daysDiff <= 2) {\n      reminderStage = \"gentle\";   // due soon\n    } else if (daysDiff === 0) {\n      reminderStage = \"firm\";     // due today\n    } else if (daysDiff < 0) {\n      reminderStage = \"urgent\";   // overdue\n    }\n  }\n\n  // --- Return with reminderStage ---\n  return {\n    json: {\n      ...item.json,\n      reminderStage,\n      daysDiff\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        1024
      ],
