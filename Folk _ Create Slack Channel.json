    {
      "parameters": {
        "jsCode": "const folk = $('GET Person Details1').first().json.data;\nconst memoText = $input.item.json.data;\nconst channelId = $('Create a channel').item.json.id;\n\n// Fetch URLs safely\nconst portal = folk.customFieldValues[\"grp_323c561b-8741-4c14-9a6b-e72bc1dbeb9f\"][\"Portal Link\"] || \"\";\nconst drive = folk.customFieldValues[\"grp_323c561b-8741-4c14-9a6b-e72bc1dbeb9f\"][\"Explore Google Drive Link\"] || \"\";\nconst customGPT = \"Your DQventures Strategy & AI Research Assistant (GPT)\";\n\n// Clean memo text\nlet cleanMemo = memoText\n  .replace(/\\r/g, '')\n  .trim();\n\n// Convert main section titles to medium headings (##)\ncleanMemo = cleanMemo\n  .replace(/^(Problem Understanding)\\s*$/gm, '## $1')\n  .replace(/^(Initial Customer Profile Understanding)\\s*$/gm, '## $1')\n  .replace(/^(Initial Solution)\\s*$/gm, '## $1')\n  .replace(/^(Rationale for Solution)\\s*$/gm, '## $1')\n  .replace(/^(Why We Think This Can Succeed)\\s*$/gm, '## $1')\n  .replace(/^(Key Risks)\\s*$/gm, '## $1');\n\n// Convert sub-headings to small headings (###)\ncleanMemo = cleanMemo\n  .replace(/^(Market Problem Description:)\\s*$/gmi, '### $1')\n  .replace(/^(Validation & Significance:)\\s*$/gmi, '### $1')\n  .replace(/^(Primary Customer Segment:)\\s*$/gmi, '### $1')\n  .replace(/^(Pain Points:)\\s*$/gmi, '### $1')\n  .replace(/^(Customer Journey Insight:)\\s*$/gmi, '### $1')\n  .replace(/^(Solution Overview:)\\s*$/gmi, '### $1')\n  .replace(/^(Competitive Advantage:)\\s*$/gmi, '### $1')\n  .replace(/^(Market Opportunity:)\\s*$/gmi, '### $1')\n  .replace(/^(Founder-Market Fit:)\\s*$/gmi, '### $1')\n  .replace(/^(Technical Feasibility:)\\s*$/gmi, '### $1')\n  .replace(/^(Business Model Viability:)\\s*$/gmi, '### $1')\n  .replace(/^(Market Signals:)\\s*$/gmi, '### $1')\n  .replace(/^(Strategic Advantage:)\\s*$/gmi, '### $1')\n  .replace(/^(Founder Strength:)\\s*$/gmi, '### $1');\n\n// Normalize bullet point indentation (remove excessive leading spaces)\n// This prevents them from being rendered as code blocks\ncleanMemo = cleanMemo.replace(/^\\s+\\*/gm, '* ');\n\n// Build the canvas content with proper spacing\nconst canvasContent = `${portal ? `[Your DQventures Portal](${portal})\\n\\n` : 'Your DQventures Portal\\n\\n'}${drive ? `[Your Google Drive Folder](${drive})\\n\\n` : 'Your Google Drive Folder\\n\\n'}${customGPT}\\n\\n# Investment Memo\\n\\n${cleanMemo}`;\n\n// Slack request payload\nreturn [{\n  json: {\n    request_payload: {\n      title: `Quick Links`,\n      document_content: {\n        type: \"markdown\",\n        markdown: canvasContent\n      },\n      channel_id: channelId\n    }\n  }\n}];"
      },
