    {
      "parameters": {
        "jsCode": "const channelId = $('Create a channel').item.json.id;\n\n// Get person data directly from GET Person Details node\nconst personDetails = $('GET Person Details').first().json.data;\n\n// Get all custom field values for this group\nconst customFields = personDetails?.customFieldValues?.[\"grp_323c561b-8741-4c14-9a6b-e72bc1dbeb9f\"];\n\n// Get the Investment Memo URL\nconst investmentMemoUrl = customFields?.[\"Investment Memo 1\"];\n\nconsole.log(\"Investment Memo URL:\", investmentMemoUrl);\nconsole.log(\"Channel ID:\", channelId);\n\n// Fetch other URLs safely\nconst portal = customFields?.[\"Portal Link\"] || \"\";\nconst drive = customFields?.[\"Explore Google Drive Link\"] || \"\";\nconst customGPT = \"Your DQventures Strategy & AI Research Assistant (GPT)\";\n\n// Build canvas content with just the link (no memo text)\nconst canvasContent = `${portal ? `[Your DQventures Portal](${portal})\\n\\n` : 'Your DQventures Portal\\n\\n'}${drive ? `[Your Google Drive Folder](${drive})\\n\\n` : 'Your Google Drive Folder\\n\\n'}${customGPT}\\n\\n# Investment Memo\\n\\n${investmentMemoUrl ? `[View Investment Memo](${investmentMemoUrl})` : 'Investment Memo link not available'}`;\n\n// Slack request payload\nreturn [{\n  json: {\n    channelId: channelId,\n    request_payload: {\n      title: `Quick Links`,\n      document_content: {\n        type: \"markdown\",\n        markdown: canvasContent\n      },\n      channel_id: channelId\n    }\n  }\n}];"
      },
