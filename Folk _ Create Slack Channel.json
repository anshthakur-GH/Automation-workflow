      "parameters": {
        "jsCode": "// Get Folk person data\nconst personData = $('GET Person Details').item.json.data;\n\n// Normalize name (same logic as \"Create a channel\" node)\nconst firstName = (personData.firstName || \"user\")\n  .normalize(\"NFD\")\n  .replace(/[^\\u0000-\\u007F]/g, \"\")\n  .toLowerCase()\n  .replace(/[^a-z0-9]/g, \"\")\n  .slice(0, 35);\n\nconst lastName = (personData.lastName || \"unknown\")\n  .normalize(\"NFD\")\n  .replace(/[^\\u0000-\\u007F]/g, \"\")\n  .toLowerCase()\n  .replace(/[^a-z0-9]/g, \"\")\n  .slice(0, 35);\n\nconst expectedChannelName = `e--${firstName}--${lastName}`.slice(0, 80);\n\nconsole.log('expectedchannel name', expectedChannelName)\n// Get all channels from \"Get many channels\"\nconst channels = $input.all();\n\n// Check if channel exists\nconst existingChannel = channels.find(item => item.json.name === expectedChannelName);\n\nconsole.log('existing channel', existingChannel);\n\n// Prepare output data\nconst outputData = {\n  channelExists: !!existingChannel,\n  expectedChannelName: expectedChannelName,\n  personData: personData,\n  data: personData  // Add this so \"Create a channel\" can access it via $json.data\n};\n\n// Add channel info if it exists\nif (existingChannel) {\n  outputData.channelId = existingChannel.json.id;  // This is the key field!\n  outputData.channelName = existingChannel.json.name;\n  outputData.id = existingChannel.json.id;  // Also add as 'id' for consistency\n}\n\n// Return single output\nreturn [{\n  json: outputData\n}];"
      },
