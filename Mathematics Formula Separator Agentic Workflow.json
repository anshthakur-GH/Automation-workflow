    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet allFormulas = [];\n\n// Parse AI output\nfor (const item of items) {\n  try {\n    let rawText = item.json.output || item.json.text || JSON.stringify(item.json);\n\n    rawText = rawText\n      .replace(/```json\\s*/g, '')\n      .replace(/```\\s*/g, '')\n      .trim();\n\n    if (!rawText.startsWith('[')) {\n      const match = rawText.match(/\\[[\\s\\S]*\\]/);\n      if (match) rawText = match[0];\n    }\n\n    let parsed = JSON.parse(rawText);\n    if (!Array.isArray(parsed)) parsed = [parsed];\n\n    allFormulas = allFormulas.concat(parsed);\n  } catch (error) {\n    console.error('Parse error:', error.message);\n  }\n}\n\n// Fix double slashes\nallFormulas = allFormulas.map(f => {\n  if (f.latex_form) {\n    f.latex_form = f.latex_form.replace(/\\\\\\\\/g, '\\\\');\n  }\n  return f;\n});\n\n// Normalize for deduplication\nfunction normalize(latex) {\n  if (!latex) return '';\n  return latex.toLowerCase()\n    .replace(/\\s+/g, '')\n    .replace(/\\\\times/g, '*')\n    .replace(/\\\\cdot/g, '*')\n    .replace(/\\{|\\}/g, '')\n    .replace(/\\^1(?![0-9])/g, '');\n}\n\n// Simpler validation – accept all formulas with \"=\"\nfunction isRealFormula(formula) {\n  const latex = formula.latex_form || '';\n  if (!latex.includes('=')) return false;\n  return true;\n}\n\n// Deduplicate\nconst seen = new Map();\nconst unique = [];\n\nfor (const formula of allFormulas) {\n  const norm = normalize(formula.latex_form);\n  if (!norm || seen.has(norm)) continue;\n  seen.set(norm, true);\n  unique.push(formula);\n}\n\n// Filter valid (topic is OPTIONAL)\nconst valid = unique.filter(f => {\n  return f.latex_form && \n         f.res_title && \n         f.res_desc &&\n         isRealFormula(f);   // topic NOT required\n});\n\n// Final output\nreturn valid.map((formula) => ({\n  json: {\n    key_chapter_id: formula.key_chapter_id || \"1062CH01\",\n    res_category: \"formula\",\n    res_desc: formula.res_desc || \"\",\n    res_title: formula.res_title || \"\",\n    res_lang: \"en\",\n    latex_form: formula.latex_form || \"\",\n    topic: formula.topic || \"\",   // keep empty if empty\n    example_text: formula.example_text || formula.example || \"\",\n    created_on: new Date().toISOString(),\n    created_by: \"ai_agent\"\n  }\n}));\n"
      },
