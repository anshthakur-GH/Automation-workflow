    {
      "parameters": {
        "jsCode": "const item = $json;\n\nconst extractedText = item?.content?.parts?.[0]?.text || \"\";\n\n// Normalize unicode subscripts and superscripts to prevent LaTeX issues\nlet cleanedText = extractedText\n  // Replace unicode subscripts with regular numbers\n  .replace(/₀/g, '0').replace(/₁/g, '1').replace(/₂/g, '2')\n  .replace(/₃/g, '3').replace(/₄/g, '4').replace(/₅/g, '5')\n  .replace(/₆/g, '6').replace(/₇/g, '7').replace(/₈/g, '8')\n  .replace(/₉/g, '9').replace(/ₙ/g, 'n')\n  \n  // Replace unicode superscripts\n  .replace(/⁰/g, '0').replace(/¹/g, '1').replace(/²/g, '2')\n  .replace(/³/g, '3').replace(/⁴/g, '4').replace(/⁵/g, '5')\n  .replace(/⁶/g, '6').replace(/⁷/g, '7').replace(/⁸/g, '8')\n  .replace(/⁹/g, '9').replace(/ⁿ/g, 'n')\n  \n  // Normalize whitespace\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nreturn [{\n  json: {\n    extracted_text: cleanedText\n  }\n}];"
      },
