    {
      "parameters": {
        "jsCode": "// Access binary data from the first input item\nconst item = $input.first();\nconst bin = item.binary?.Upload_Topic_File;\n\nlet filename = null;\nlet extension = null;\nlet fileTypeFlag = \"OTHER\";\n\nif (bin && bin.fileName) {\n  filename = bin.fileName;\n  const parts = filename.split(\".\");\n  extension = parts.length > 1 ? parts.pop().toLowerCase() : null;\n  if ([\"xlsx\", \"xls\"].includes(extension)) {\n    fileTypeFlag = \"EXCEL\";\n  }\n}\n\n// RETURN both JSON + the original binary file\nreturn {\n  json: {\n    filename,\n    fileExtension: extension,\n    fileTypeFlag\n  },\n  binary: {\n    Upload_Topic_File: bin\n  }\n};"
      },
