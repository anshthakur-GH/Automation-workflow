    {
      "parameters": {
        "jsCode": "// Get the loop item data\nconst loopItem = $('Loop Over Items').item.json;\n\n// Get all items from the merge (SERP Research + SERP NEWS + Supabase)\nconst mergedData = $input.all();\n\n// Separate SERP Research, SERP News, and Supabase data\nconst serpResearch = mergedData.find(item => item.json.organic || item.json.organic_results);\nconst serpNews = mergedData.find(item => item.json.news);\nconst supabaseData = mergedData.find(item => item.json.data || Array.isArray(item.json));\n\n// Extract and combine reference content from Supabase\nlet referenceContent = '';\nif (supabaseData) {\n  // Handle both single object and array responses\n  const rows = Array.isArray(supabaseData.json) ? supabaseData.json : [supabaseData.json];\n  \n  // Extract 'data' field from each row and combine\n  referenceContent = rows\n    .map(row => row.data)\n    .filter(data => data && data.trim().length > 0)\n    .join('\\n\\n--- REFERENCE DOCUMENT ---\\n\\n');\n}\n\n// Combine everything into a single output\nreturn [{\n  json: {\n    // Preserve all loop context\n    Keyword: loopItem.Keyword,\n    target_audience: loopItem.target_audience,\n    word_count: loopItem.word_count,\n    tone: loopItem.tone,\n    brand_voice: loopItem.brand_voice,\n    row_number: loopItem.row_number,\n    'Content Designed ': loopItem['Content Designed '],\n    \n    // Add structured SERP data\n    organic_results: serpResearch?.json?.organic || serpResearch?.json?.organic_results || [],\n    news: serpNews?.json?.news || [],\n    \n    // Add combined reference content from Supabase\n    reference_content: referenceContent || 'No reference content available',\n    \n    // Keep raw data for debugging if needed\n    serp_research_raw: serpResearch?.json || {},\n    serp_news_raw: serpNews?.json || {},\n    supabase_raw: supabaseData?.json || {},\n    reference_doc_count: referenceContent ? referenceContent.split('--- REFERENCE DOCUMENT ---').length : 0\n  }\n}];"
      },
